# Copy this file to .env and fill in your real EmailJS values.
# See the comment above `emailjs` in src/data/content.js for where to get
# these from the EmailJS dashboard (https://dashboard.emailjs.com).
#
# .env is already ignored by git (see .gitignore) so your keys aren't
# committed. Vite only exposes variables prefixed with VITE_ to the browser.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
